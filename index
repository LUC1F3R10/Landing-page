<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VDT-101 Simulator — petroleum.sim</title>
<meta name="description" content="محاكاة احترافية لبرج التقطير الفراغي · أداة تدريب لمهندسي البترول">

<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Tajawal:wght@300;400;500;700;800;900&family=Bebas+Neue&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --blue:    #00d4ff;
  --blue-d:  #0099cc;
  --yellow:  #ffd633;
  --amber:   #ffaa00;
  --green:   #2ecc71;
  --red:     #e74c3c;
  --purple:  #9b59b6;
  --black:   #000000;
  --dark:    #060e18;
  --dark-2:  #0a1420;
  --dark-3:  #0d1827;
  --light:   #a8c4dd;
  --light-2: #7a9ec2;
  --white:   #ffffff;
  --border:  rgba(0,212,255,0.15);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Tajawal', sans-serif;
  background: var(--black);
  color: var(--white);
  line-height: 1.6;
  overflow-x: hidden;
  font-size: 16px;
}

/* ════════════════════════════
   FIXED HEADER
════════════════════════════ */
header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(6,14,24,0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 14px 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  direction: ltr;
}

.logo {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1px;
}
.logo .at { color: var(--yellow); }
.logo .pet { color: var(--blue); }
.logo .dot { color: var(--yellow); }
.logo .sim { color: var(--yellow); }

nav { display: flex; gap: 24px; }
nav a {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 13px;
  color: var(--light);
  text-decoration: none;
  letter-spacing: 1px;
  transition: color 0.2s;
}
nav a:hover { color: var(--blue); }

.cta-header {
  background: var(--blue);
  color: var(--black);
  padding: 8px 18px;
  border-radius: 6px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-decoration: none;
  transition: all 0.2s;
}
.cta-header:hover {
  background: var(--yellow);
  transform: translateY(-1px);
}

@media (max-width: 768px) {
  header { padding: 12px 16px; }
  nav { display: none; }
}

/* ════════════════════════════
   HERO SECTION
════════════════════════════ */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  padding: 100px 32px 60px;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,212,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,0.025) 1px, transparent 1px);
  background-size: 50px 50px;
  z-index: 0;
}

.hero-glow-1 {
  position: absolute;
  top: -200px; right: -200px;
  width: 800px; height: 800px;
  background: radial-gradient(circle, rgba(0,212,255,0.15) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  animation: pulse 8s ease-in-out infinite;
}

.hero-glow-2 {
  position: absolute;
  bottom: -300px; left: -150px;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(255,214,51,0.08) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  animation: pulse 10s ease-in-out infinite reverse;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.1); }
}

.scan-lines {
  position: absolute; inset: 0;
  background: repeating-linear-gradient(
    to bottom, transparent, transparent 3px,
    rgba(0,0,0,0.04) 3px, rgba(0,0,0,0.04) 4px
  );
  z-index: 1;
  pointer-events: none;
}

.hero-content {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

@media (max-width: 1024px) {
  .hero-content { grid-template-columns: 1fr; gap: 40px; }
}

.hero-left {
  text-align: right;
}

.tagline {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 13px;
  color: var(--blue);
  letter-spacing: 4px;
  padding: 8px 20px;
  border: 1.5px solid rgba(0,212,255,0.3);
  border-radius: 30px;
  background: rgba(0,212,255,0.05);
  margin-bottom: 24px;
  direction: ltr;
  animation: fadeInUp 0.8s ease-out;
}

h1 {
  font-family: 'Tajawal', sans-serif;
  font-size: clamp(40px, 6vw, 72px);
  font-weight: 900;
  line-height: 1.2;
  margin-bottom: 24px;
  letter-spacing: 0;
  animation: fadeInUp 0.8s ease-out 0.1s both;
}

h1 .accent {
  background: linear-gradient(120deg, var(--blue), var(--yellow));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
}

.hero-sub {
  font-family: 'Tajawal', sans-serif;
  font-size: 22px;
  color: var(--light);
  line-height: 1.7;
  margin-bottom: 36px;
  max-width: 540px;
  margin-right: 0;
  margin-left: auto;
  animation: fadeInUp 0.8s ease-out 0.2s both;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 40px;
  animation: fadeInUp 0.8s ease-out 0.3s both;
}

.stat {
  background: rgba(13,24,39,0.6);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px;
  text-align: center;
  backdrop-filter: blur(6px);
}

.stat-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 42px;
  line-height: 1;
  background: linear-gradient(180deg, var(--blue), var(--blue-d));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-num.yellow {
  background: linear-gradient(180deg, var(--yellow), var(--amber));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-num.green {
  background: linear-gradient(180deg, var(--green), #27ae60);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-label {
  font-family: 'Tajawal', sans-serif;
  font-size: 13px;
  color: var(--light-2);
  margin-top: 4px;
}

.hero-cta {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: flex-end;
  animation: fadeInUp 0.8s ease-out 0.4s both;
}

.btn {
  font-family: 'Tajawal', sans-serif;
  font-size: 16px;
  font-weight: 700;
  padding: 16px 32px;
  border-radius: 10px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  transition: all 0.25s;
  border: 2px solid transparent;
  cursor: pointer;
}

.btn-primary {
  background: var(--blue);
  color: var(--black);
  box-shadow: 0 8px 24px rgba(0,212,255,0.3);
}
.btn-primary:hover {
  background: var(--yellow);
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(255,214,51,0.4);
}

.btn-secondary {
  background: transparent;
  color: var(--blue);
  border-color: var(--blue);
}
.btn-secondary:hover {
  background: rgba(0,212,255,0.1);
  transform: translateY(-2px);
}

/* HERO RIGHT — Visual Preview */
.hero-right {
  position: relative;
  animation: fadeInUp 0.8s ease-out 0.3s both;
}

.preview-frame {
  position: relative;
  background: linear-gradient(180deg, var(--dark-3) 0%, var(--dark) 100%);
  border: 1.5px solid var(--border);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 60px rgba(0,212,255,0.1);
  direction: ltr;
}

.preview-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.preview-dot { width: 10px; height: 10px; border-radius: 50%; background: #e74c3c; }
.preview-dot:nth-child(2) { background: #f39c12; }
.preview-dot:nth-child(3) { background: #2ecc71; }
.preview-title {
  margin-left: 10px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  color: var(--light-2);
  letter-spacing: 1px;
}

.preview-body {
  position: relative;
  height: 360px;
  background: var(--dark);
  border-radius: 10px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* SVG Mini P&ID */
.mini-pid {
  width: 100%; height: 100%;
}

@keyframes flow-dash {
  to { stroke-dashoffset: -20; }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

.live-tag {
  position: absolute;
  top: 14px;
  right: 14px;
  background: rgba(231,76,60,0.15);
  border: 1px solid rgba(231,76,60,0.4);
  border-radius: 4px;
  padding: 4px 10px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  color: var(--red);
  letter-spacing: 2px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.live-dot {
  width: 6px; height: 6px;
  background: var(--red);
  border-radius: 50%;
  animation: blink 1.2s ease-in-out infinite;
}

/* ════════════════════════════
   SECTION COMMON
════════════════════════════ */
section {
  padding: 100px 32px;
  position: relative;
  overflow: hidden;
}

.section-inner {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.section-label {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  letter-spacing: 4px;
  color: var(--yellow);
  margin-bottom: 16px;
  padding: 6px 16px;
  border: 1px solid rgba(255,214,51,0.3);
  border-radius: 20px;
  background: rgba(255,214,51,0.05);
  direction: ltr;
}

.section-title {
  font-family: 'Tajawal', sans-serif;
  font-size: clamp(32px, 4.5vw, 52px);
  font-weight: 900;
  line-height: 1.3;
  margin-bottom: 20px;
  text-align: right;
}

.section-sub {
  font-family: 'Tajawal', sans-serif;
  font-size: 20px;
  color: var(--light);
  line-height: 1.7;
  margin-bottom: 60px;
  max-width: 720px;
  text-align: right;
}

/* ════════════════════════════
   FEATURES SECTION
════════════════════════════ */
.features-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 80% 20%, rgba(0,212,255,0.04) 0%, transparent 50%),
    radial-gradient(circle at 20% 80%, rgba(255,214,51,0.03) 0%, transparent 50%);
  z-index: 0;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

@media (max-width: 900px) {
  .features-grid { grid-template-columns: 1fr; }
}

.feature {
  background: linear-gradient(180deg, rgba(13,24,39,0.6) 0%, rgba(10,20,32,0.3) 100%);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 32px;
  position: relative;
  transition: all 0.3s;
  overflow: hidden;
}

.feature:hover {
  transform: translateY(-4px);
  border-color: rgba(0,212,255,0.4);
  box-shadow: 0 16px 40px rgba(0,212,255,0.1);
}

.feature::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 60px; height: 60px;
  background: var(--blue);
  opacity: 0.05;
  border-radius: 0 0 60px 0;
  transition: all 0.3s;
}

.feature:hover::before {
  opacity: 0.15;
  width: 100px;
  height: 100px;
}

.feature-icon {
  font-size: 36px;
  margin-bottom: 18px;
  display: inline-block;
  filter: grayscale(0);
}

.feature-num {
  position: absolute;
  top: 24px;
  left: 24px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 56px;
  color: rgba(255,255,255,0.05);
  line-height: 1;
  pointer-events: none;
}

.feature-title {
  font-family: 'Tajawal', sans-serif;
  font-size: 22px;
  font-weight: 800;
  margin-bottom: 12px;
  color: var(--white);
}

.feature-desc {
  font-family: 'Tajawal', sans-serif;
  font-size: 15px;
  color: var(--light);
  line-height: 1.7;
}

/* ════════════════════════════
   HIGHLIGHTS SECTION (dark band)
════════════════════════════ */
.highlights {
  background: linear-gradient(180deg, var(--dark) 0%, #050a12 100%);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.highlights-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}

@media (max-width: 900px) {
  .highlights-grid { grid-template-columns: 1fr; }
}

.checklist {
  list-style: none;
  padding: 0;
}

.checklist li {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px dashed rgba(168,196,221,0.15);
  direction: rtl;
}

.checklist li:last-child { border-bottom: none; }

.check-icon {
  width: 36px; height: 36px;
  background: rgba(46,204,113,0.12);
  border: 1.5px solid var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: var(--green);
  flex-shrink: 0;
}

.check-text {
  flex: 1;
  text-align: right;
}

.check-title {
  font-family: 'Tajawal', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 4px;
}

.check-desc {
  font-family: 'Tajawal', sans-serif;
  font-size: 14px;
  color: var(--light-2);
  line-height: 1.6;
}

/* Stats card */
.big-stats-card {
  background: linear-gradient(135deg, rgba(0,212,255,0.06) 0%, rgba(255,214,51,0.03) 100%);
  border: 1.5px solid rgba(0,212,255,0.3);
  border-radius: 20px;
  padding: 40px;
}

.big-stat {
  margin-bottom: 32px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
}

.big-stat:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.big-stat-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  color: var(--light-2);
  letter-spacing: 3px;
  margin-bottom: 8px;
  direction: ltr;
}

.big-stat-value {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  line-height: 1;
  background: linear-gradient(180deg, var(--blue), var(--blue-d));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  direction: ltr;
  margin-bottom: 6px;
}

.big-stat-value.yellow {
  background: linear-gradient(180deg, var(--yellow), var(--amber));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.big-stat-desc {
  font-family: 'Tajawal', sans-serif;
  font-size: 16px;
  color: var(--light);
}

/* ════════════════════════════
   SCENARIOS SECTION
════════════════════════════ */
.scenarios-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

@media (max-width: 768px) {
  .scenarios-grid { grid-template-columns: 1fr; }
}

.scenario {
  background: var(--dark-3);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 28px;
  display: flex;
  gap: 20px;
  align-items: flex-start;
  direction: rtl;
  transition: all 0.3s;
}

.scenario:hover {
  border-color: rgba(0,212,255,0.4);
  transform: translateX(-4px);
}

.scenario-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 48px;
  line-height: 1;
  color: var(--blue);
  min-width: 70px;
  text-align: center;
  border-left: 2px solid rgba(0,212,255,0.2);
  padding-left: 16px;
}

.scenario-body { flex: 1; text-align: right; }

.scenario-title {
  font-family: 'Tajawal', sans-serif;
  font-size: 20px;
  font-weight: 800;
  margin-bottom: 6px;
}

.scenario-tag {
  display: inline-block;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: 1px;
  padding: 3px 10px;
  border-radius: 4px;
  margin-bottom: 8px;
  direction: ltr;
}

.scenario-tag.basic { background: rgba(46,204,113,0.15); color: var(--green); }
.scenario-tag.intermediate { background: rgba(255,214,51,0.12); color: var(--yellow); }
.scenario-tag.advanced { background: rgba(155,89,182,0.15); color: var(--purple); }
.scenario-tag.critical { background: rgba(231,76,60,0.15); color: var(--red); }

.scenario-desc {
  font-family: 'Tajawal', sans-serif;
  font-size: 15px;
  color: var(--light);
  line-height: 1.6;
}

/* ════════════════════════════
   FOR-WHO SECTION
════════════════════════════ */
.who-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

@media (max-width: 900px) {
  .who-grid { grid-template-columns: 1fr; }
}

.who-card {
  text-align: center;
  padding: 36px 28px;
  background: linear-gradient(180deg, rgba(13,24,39,0.4), rgba(10,20,32,0.2));
  border: 1px solid var(--border);
  border-radius: 16px;
  transition: all 0.3s;
}

.who-card:hover {
  transform: translateY(-6px);
  border-color: rgba(255,214,51,0.3);
}

.who-icon {
  font-size: 52px;
  margin-bottom: 16px;
  display: block;
}

.who-title {
  font-family: 'Tajawal', sans-serif;
  font-size: 22px;
  font-weight: 800;
  margin-bottom: 10px;
  color: var(--yellow);
}

.who-desc {
  font-family: 'Tajawal', sans-serif;
  font-size: 15px;
  color: var(--light);
  line-height: 1.7;
}

/* ════════════════════════════
   CTA / CONTACT SECTION
════════════════════════════ */
.contact-section {
  background: linear-gradient(180deg, #050a12 0%, var(--black) 100%);
  border-top: 1px solid var(--border);
  position: relative;
}

.contact-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 50% 20%, rgba(0,212,255,0.1) 0%, transparent 60%);
  pointer-events: none;
}

.contact-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 2;
}

.contact-content .section-label {
  display: inline-block;
  margin-bottom: 24px;
}

.contact-content h2 {
  font-family: 'Tajawal', sans-serif;
  font-size: clamp(36px, 5vw, 56px);
  font-weight: 900;
  line-height: 1.3;
  margin-bottom: 24px;
}

.contact-content .lead {
  font-family: 'Tajawal', sans-serif;
  font-size: 20px;
  color: var(--light);
  line-height: 1.7;
  margin-bottom: 48px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  max-width: 700px;
  margin: 0 auto 32px;
}

@media (max-width: 600px) {
  .contact-grid { grid-template-columns: 1fr; }
}

.contact-card {
  background: linear-gradient(180deg, var(--dark-3), var(--dark-2));
  border: 1.5px solid var(--border);
  border-radius: 14px;
  padding: 24px;
  text-decoration: none;
  color: var(--white);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  gap: 18px;
  text-align: right;
}

.contact-card:hover {
  border-color: var(--blue);
  transform: translateY(-3px);
  box-shadow: 0 12px 30px rgba(0,212,255,0.15);
}

.contact-icon {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  background: rgba(0,212,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  flex-shrink: 0;
}

